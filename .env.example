# Public site URL (no trailing slash) — used for sitemap, canonical, Open Graph
# Production must be the live domain (canonical + sitemap + Open Graph)
NEXT_PUBLIC_SITE_URL=https://umarshoaib.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Comma-separated emails allowed into /admin (required in production)
ADMIN_EMAILS=you@example.com

# Chatbot — free Gemini (primary) + Groq (backup). Set at least one.
# Prefer adding keys in Admin → Chatbot (supports many keys + auto fallback).
# Optional env backups (comma-separated allowed):
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEYS=key1,key2,key3
# GEMINI_API_KEY=
# Groq Cloud: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_API_KEYS=key1,key2,key3
# Optional dedicated secret used to encrypt admin-entered chatbot keys:
# CHATBOT_KEYS_SECRET=long-random-string
